{
  "$schema": "../program.schema.json",
  "id": "child-tax-credit",
  "name": "Child Tax Credit (CTC)",
  "category": "tax",
  "appliesTo": "household",
  "audience": { "fact": "householdHasChild", "eq": true },
  "apply": {
    "url": "https://www.irs.gov/individuals/free-tax-return-preparation-for-qualifying-taxpayers",
    "phone": "1-800-906-9887",
    "where": "tax"
  },
  "documents": ["taxIds", "taxForms", "childRecords"],
  "estimate": { "table": "actc-per-child", "by": "ctcKids", "phaseIn": { "rate": 0.15, "over": 2500 } },
  "rules": [
    {
      "id": "ctc-ssn-parent",
      "effective": { "from": "2026-01-01", "to": null },
      "conditions": {
        "all": [
          { "fact": "ctcKids", "gte": 1 },
          { "fact": "ssnAllAdults", "eq": true },
          { "fact": "earnedIncome", "gte": 2500 },
          { "fact": "annualIncome", "lte": 200000 }
        ]
      },
      "explain": "tax.ctc2025",
      "notes": [{ "key": "tax.pastYears" }],
      "source": "https://www.irs.gov/credits-deductions/individuals/child-tax-credit",
      "lastVerified": "2026-10-19",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "ctc-ssn-parent-partial",
      "effective": { "from": "2026-01-01", "to": null },
      "conditions": {
        "all": [
          { "fact": "ctcKids", "gte": 1 },
          { "fact": "ssnAdult", "eq": true },
          { "fact": "earnedIncome", "gte": 2500 },
          { "fact": "annualIncome", "lte": { "table": "ctc-phaseout-end", "by": "kidsUnder17" } }
        ]
      },
      "outcome": "possibly",
      "explain": "tax.ctc2025",
      "notes": [
        { "key": "tax.filerSsn", "when": { "fact": "ssnAllAdults", "eq": false } },
        { "key": "tax.ctcPhaseOut", "when": { "fact": "annualIncome", "gt": 200000 } },
        { "key": "tax.pastYears" }
      ],
      "source": "https://www.law.cornell.edu/uscode/text/26/24",
      "lastVerified": "2026-10-22",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "ctc-itin-parent",
      "effective": { "from": "2025-01-01", "to": "2025-12-31" },
      "conditions": { "all": [{ "fact": "ctcKids", "gte": 1 }, { "fact": "earnedIncome", "gte": 2500 }, { "fact": "annualIncome", "lte": 200000 }] },
      "explain": "tax.ctc2024",
      "notes": [{ "key": "tax.pastYears" }],
      "source": "https://www.irs.gov/credits-deductions/individuals/child-tax-credit",
      "lastVerified": "2026-10-19",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "ctc-itin-parent-partial",
      "effective": { "from": "2025-01-01", "to": "2025-12-31" },
      "conditions": { "all": [
        { "fact": "ctcKids", "gte": 1 },
        { "fact": "earnedIncome", "gte": 2500 },
        { "fact": "annualIncome", "lte": { "table": "ctc-phaseout-end", "by": "kidsUnder17" } }
      ]},
      "outcome": "possibly",
      "explain": "tax.ctc2024",
      "notes": [{ "key": "tax.ctcPhaseOut", "when": { "fact": "annualIncome", "gt": 200000 } }, { "key": "tax.pastYears" }],
      "source": "https://www.law.cornell.edu/uscode/text/26/24",
      "lastVerified": "2026-10-22",
      "verifiedBy": "claude-draft"
    }
  ]
}
