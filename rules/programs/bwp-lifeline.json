    {
      "id": "bwp-lifeline-income-or-program",
      "effective": { "from": "2026-01-01", "to": null },
      "conditions": { "any": [
        { "fact": "incomePctFPL", "lte": 200 },
        { "fact": "getsCalFresh", "eq": true }
      ]},
      "explain": "bwp.eligible",
      "notes": [{ "key": "bwp.buss" }],
      "source": "https://www.burbankwaterandpower.com/my-home/lifeline-program",
