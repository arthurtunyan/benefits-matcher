{
  "$schema": "../program.schema.json",
  "id": "early-learning",
  "name": "Head Start · Early Head Start · State Preschool",
  "category": "family",
  "appliesTo": "person",
  "audience": { "any": [{ "fact": "age", "lt": 5 }, { "fact": "pregnant", "eq": true }] },
  "apply": { "url": "https://www.ccala.net", "phone": "211", "where": "earlyLearning" },
  "documents": ["income", "birthCertificates", "address", "childRecords"],
  "alternatives": ["211"],
  "rules": [
    {
      "id": "head-start",
      "variant": "headStart",
      "effective": { "from": "2016-01-01", "to": null },
      "conditions": { "all": [
        { "fact": "age", "gte": 3 },
        { "fact": "age", "lt": 5 },
        { "any": [{ "fact": "incomePctFPL", "lte": 100 }, { "fact": "getsCalWORKs", "eq": true }, { "fact": "getsSSI", "eq": true }] }
      ]},
      "explain": "el.headStart",
      "notes": [{ "key": "el.noStatus" }],
      "source": "https://eclkc.ohs.acf.hhs.gov/policy/45-cfr-chap-xiii/1302-12-determining-verifying-documenting-eligibility",
      "lastVerified": "2026-10-07",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "early-head-start",
      "variant": "earlyHeadStart",
      "effective": { "from": "2016-01-01", "to": null },
      "conditions": { "all": [
        { "any": [{ "fact": "age", "lt": 3 }, { "fact": "pregnant", "eq": true }] },
        { "any": [{ "fact": "incomePctFPL", "lte": 100 }, { "fact": "getsCalWORKs", "eq": true }, { "fact": "getsSSI", "eq": true }] }
      ]},
      "explain": "el.earlyHeadStart",
      "notes": [{ "key": "el.noStatus" }],
      "source": "https://eclkc.ohs.acf.hhs.gov/policy/45-cfr-chap-xiii/1302-12-determining-verifying-documenting-eligibility",
      "lastVerified": "2026-10-07",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "state-preschool",
      "variant": "statePreschool",
      "effective": { "from": "2026-07-01", "to": null },
      "conditions": { "all": [
        { "fact": "age", "gte": 3 },
        { "fact": "age", "lt": 5 },
        { "any": [{ "fact": "monthlyIncome", "lte": { "table": "cspp-monthly" } }, { "fact": "getsCalWORKs", "eq": true }] }
      ]},
      "explain": "el.statePreschool",
      "source": "https://www.cde.ca.gov/sp/cd/ci/mb2603.asp",
      "lastVerified": "2026-10-07",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "head-start-up-to-130",
      "variant": "headStart",
      "effective": { "from": "2016-01-01", "to": null },
      "outcome": "possibly",
      "conditions": { "all": [
        { "fact": "age", "gte": 3 },
        { "fact": "age", "lt": 5 },
        { "fact": "incomePctFPL", "lte": 130 }
      ]},
      "explain": "el.upTo130",
      "source": "https://eclkc.ohs.acf.hhs.gov/policy/45-cfr-chap-xiii/1302-12-determining-verifying-documenting-eligibility",
      "lastVerified": "2026-10-07",
      "verifiedBy": "claude-draft"
    },
    {
      "id": "early-head-start-up-to-130",
      "variant": "earlyHeadStart",
      "effective": { "from": "2016-01-01", "to": null },
      "outcome": "possibly",
      "conditions": { "all": [
        { "any": [{ "fact": "age", "lt": 3 }, { "fact": "pregnant", "eq": true }] },
        { "fact": "incomePctFPL", "lte": 130 }
      ]},
      "explain": "el.upTo130",
      "source": "https://eclkc.ohs.acf.hhs.gov/policy/45-cfr-chap-xiii/1302-12-determining-verifying-documenting-eligibility",
      "lastVerified": "2026-10-07",
      "verifiedBy": "claude-draft"
    }
  ]
}
