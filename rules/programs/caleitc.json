{
  "$schema": "../program.schema.json",
  "id": "caleitc",
  "name": "California Earned Income Tax Credit (CalEITC)",
  "category": "tax",
  "appliesTo": "household",
  "apply": {
    "url": "https://www.ftb.ca.gov/file/personal/credits/caleitc/index.html",
    "phone": "1-800-852-5711",
    "where": "tax"
  },
  "documents": ["taxIds", "taxForms", "childRecords"],
  "estimate": { "table": "caleitc-max", "by": "taxKids" },
  "rules": [
    {
      "id": "caleitc",
      "effective": { "from": "2025-01-01", "to": null },
      "conditions": {
        "all": [{ "fact": "earnedIncome", "gt": 0 }, { "fact": "earnedIncome", "lte": { "table": "caleitc-limit" } }]
      },
      "explain": "tax.caleitc",
      "notes": [{ "key": "tax.itin" }, { "key": "tax.caResident" }, { "key": "tax.pastYears" }],
      "source": "https://www.ftb.ca.gov/file/personal/credits/caleitc/eligibility-and-credit-information.html",
      "lastVerified": "2026-10-19",
      "verifiedBy": "claude-draft"
    }
  ]
}
