{
  "$schema": "../program.schema.json",
  "id": "socalgas-care",
  "name": "SoCalGas CARE",
  "category": "utility",
  "appliesTo": "household",
  "audience": { "fact": "gas", "eq": "socalgas" },
  "apply": { "url": "https://www.socalgas.com/save-money-and-energy/assistance-programs/california-alternate-rates-for-energy", "phone": "1-800-427-2200", "where": "utility" },
  "documents": ["utilityBill", "incomeOrBenefitLetter"],
  "estimate": { "text": "socalgasCare" },
  "rules": [
    {
      "id": "socalgas-care",
      "effective": { "from": "2016-01-01", "to": null },
      "conditions": { "any": [
        { "fact": "annualIncome", "lte": { "table": "care-annual" } },
        { "fact": "getsCalFresh", "eq": true },
        { "fact": "getsCalWORKs", "eq": true },
        { "fact": "anyoneHasMediCal", "eq": true },
        { "fact": "getsSSI", "eq": true },
        { "fact": "getsWIC", "eq": true }
      ]},
      "explain": "care.socalgas",
      "source": "https://www.cpuc.ca.gov/industries-and-topics/electrical-energy/electric-costs/care-fera-program",
      "lastVerified": "2026-10-07",
      "verifiedBy": "claude-draft"
    }
  ]
}
