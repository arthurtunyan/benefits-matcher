{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "program.schema.json",
  "title": "Benefits program rules",
  "description": "One public-benefit program and its dated eligibility rules. Long-standing rules use effective.from 2016-01-01, meaning 'in force before this dataset begins'.",
  "type": "object",
  "required": ["id", "name", "category", "appliesTo", "apply", "documents", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "description": "Official program name. Stays in English so families recognize it at the office." },
    "category": { "enum": ["health", "food", "cash", "family", "utility", "transit"] },
    "appliesTo": { "enum": ["person", "household"] },
    "audience": { "$ref": "#/definitions/cond", "description": "Who this program is relevant to. When it fails, the program is hidden instead of listed as 'not eligible'." },
    "apply": {
      "type": "object",
      "required": ["url", "where"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "phone": { "type": "string" },
        "where": { "type": "string", "description": "i18n key under where.*" }
      }
    },
    "documents": { "type": "array", "items": { "type": "string" }, "description": "i18n keys under docs.*" },
    "alternatives": { "type": "array", "items": { "type": "string" }, "description": "i18n keys under alt.*, shown when not eligible" },
    "estimate": {
      "oneOf": [
        { "type": "object", "required": ["table"], "additionalProperties": false, "properties": { "table": { "type": "string" }, "by": { "type": "string" } } },
        { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "text": { "type": "string" } } }
      ]
    },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scalar": { "type": ["number", "string", "boolean"] },
    "value": {
      "oneOf": [
        { "$ref": "#/definitions/scalar" },
        { "type": "object", "required": ["table"], "additionalProperties": false, "properties": { "table": { "type": "string" }, "by": { "type": "string" } } }
      ]
    },
    "leaf": {
      "type": "object",
      "required": ["fact"],
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 3,
      "properties": {
        "fact": { "type": "string" },
        "eq": { "$ref": "#/definitions/value" },
        "ne": { "$ref": "#/definitions/value" },
        "in": { "type": "array", "items": { "$ref": "#/definitions/scalar" } },
        "lt": { "$ref": "#/definitions/value" },
        "lte": { "$ref": "#/definitions/value" },
        "gt": { "$ref": "#/definitions/value" },
        "gte": { "$ref": "#/definitions/value" },
        "unsure": { "type": "array", "items": { "$ref": "#/definitions/scalar" } }
      }
    },
    "cond": {
      "oneOf": [
        { "$ref": "#/definitions/leaf" },
        { "type": "object", "required": ["all"], "additionalProperties": false, "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cond" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false, "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cond" } } } },
        { "type": "object", "required": ["not"], "additionalProperties": false, "properties": { "not": { "$ref": "#/definitions/cond" } } }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "effective", "conditions", "explain", "source", "lastVerified", "verifiedBy"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "variant": { "type": "string", "description": "i18n key under variants.*" },
        "effective": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "$ref": "#/definitions/date" },
            "to": { "oneOf": [{ "$ref": "#/definitions/date" }, { "type": "null" }] }
          }
        },
        "conditions": { "$ref": "#/definitions/cond" },
        "outcome": { "const": "possibly", "description": "Cap the result at 'possibly' even when every condition passes." },
        "explain": { "type": "string", "description": "i18n key under rules.*" },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "additionalProperties": false,
            "properties": { "key": { "type": "string" }, "when": { "$ref": "#/definitions/cond" } }
          }
        },
        "source": { "type": "string", "pattern": "^https://" },
        "lastVerified": { "$ref": "#/definitions/date" },
        "verifiedBy": { "type": "string" }
      }
    }
  }
}
